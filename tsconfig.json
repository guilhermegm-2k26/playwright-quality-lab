{
  "include": ["./src/**/*"],
  "exclude": ["./node_modules"],
  "compilerOptions": {    
    "types": ["node"],
    "target": "es6",    
    "module": "commonjs",
    "rootDir": "./src",    
    "outDir": "./dist",    
    "esModuleInterop": true,    
    "forceConsistentCasingInFileNames": true,    
    "strict": true,    
    "skipLibCheck": true
  }
}
