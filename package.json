{
  "name": "playwright-quality-lab",
  "version": "1.0.0",
  "description": "Laboratório de testes E2E com Playwright, TypeScript e SonarQube Cloud",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "author": "ugioni",
  "license": "MIT",
  "devDependencies": {
    "@playwright/mcp": "^0.0.83",
    "@types/node": "^25.6.0",
    "mkdirp": "^3.0.1",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0",
    "sicolo": "^1.0.1"
  },
  "scripts": {
    "clean": "rimraf ./artifacts && mkdirp ./artifacts",
    "format": "prettier --write \"**/**.[jt]s?(x)\"",
    "verify": "prettier --check \"**/**.[jt]s?(x)\"",
    "scenario": "playwright test src/scenarios/SauceDemo.spec.ts --workers 1",
    "typecheck": "tsc --noEmit",
    "test:list": "playwright test --list",
    "test": "npx playwright test --output artifacts/media --workers 4",
    "debug": "npx playwright test --output artifacts/media --debug --workers 1",
    "ui": "npx playwright test --output artifacts/media --ui --workers 1",
    "show-report": "npx playwright show-report artifacts/report",
    "actions": "npx playwright test --output artifacts/media --workers 1",
    "ci": "npm run clean && npm run verify && npm run typecheck && npm run actions"
  }
}
